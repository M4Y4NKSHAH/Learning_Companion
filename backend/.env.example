# ==============================================================================
# LearnerHelp Backend Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for cloud agentic reasoning & guided generation)
GEMINI_API_KEY=your_actual_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Hosting & Server Ports (Auto-injected by Render, defaults to 8000 locally)
PORT=10000
HOST=0.0.0.0

# CORS Origins (Comma-separated allowed origins or "*" for public access)
# In production on Render, set this to your Vercel deployment URL:
# CORS_ORIGINS=https://learnerhelp.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Persistent Storage Directory (Mount path for Render Persistent Disk, e.g. /data)
# Leaves unset to use backend/chroma_knowledge_base and backend/data/
DATA_DIR=/data

# Local LLM Service (Optional - for local GPU / Ollama execution)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:3b
