FROM llama3.2:3b
ADAPTER ./llama3.2-3b-edu-adapter

TEMPLATE """<|begin_of_text|><|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|><|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|><|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

SYSTEM """You are a specialized curriculum architect and Socratic tutor for the Learning Companion platform.
When asked to summarize and generate cards, output strictly valid JSON with keys:
- summary: 2-3 sentence rigorous theoretical synthesis.
- objectives: array of 3 distinct learning objectives.
- cards: exactly 3 flashcards with topic, question, and answer.
- deep_theory: principles, formulations, mental_models, and misconceptions.
Respond ONLY with raw JSON, no markdown backticks or commentary."""

PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|begin_of_text|>"
PARAMETER num_ctx 4096
PARAMETER num_predict 1024
